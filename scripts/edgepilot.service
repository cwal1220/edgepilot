# MaixCAM2 부팅 시 openpilot 런타임을 띄운다(scripts/install_autostart.sh가 설치한다).
# 기본 UI 런처와는 동시에 돌 수 없다(카메라·NPU·화면). 런처로 돌아가려면
#   systemctl start launcher.service   (Conflicts로 이 서비스가 멈춘다)
[Unit]
Description=openpilot runtime (manager) on MaixCAM2
Conflicts=launcher.service camcal.service
# AX 드라이버는 edgepilot-drivers.service가 부팅 초반에 올린다(rc-local은 Wi-Fi 연결을 기다려서 늦다).
# usb-gadget.sh는 끝날 때 USB 역할을 device로 쓰므로, 매니저가 host로 바꾸는 건 그 뒤여야 한다.
# 네트워크 연결은 기다리지 않는다(웹 콘솔은 0.0.0.0에 붙어 Wi-Fi가 나중에 붙어도 된다).
# wifi.service는 Type=simple이라 부팅 땐 기다림이 없고, 종료 때 edgepilot이 Wi-Fi 정리(wifi.sh stop)보다
# 먼저 내려가게 한다. 이 순서를 빼면 재부팅이 systemd-shutdown 단계에서 멈췄다(2026-10-01, 두 번).
Wants=edgepilot-drivers.service
After=launcher.service camcal.service edgepilot-drivers.service usb-gadget.service wifi.service

[Service]
Type=simple
WorkingDirectory=@DEST@
# 보드 로그인 셸과 같은 LD_LIBRARY_PATH(/opt/lib, /soc/lib …). 바이너리의 RUNPATH는 직접 링크한
# 라이브러리에만 적용돼서, libax_engine이 부르는 libax_interpreter 같은 간접 의존성은 못 찾는다.
EnvironmentFile=-/etc/environment
Environment=PYTHONUNBUFFERED=1
Environment=EDGEPILOT_LOG_DIR=/run/edgepilot
# 차에서 판다를 USB-C(호스트)로 붙인다. 맥에 USB로 연결해 디버깅하려면 device로 바꾼다.
Environment=EDGEPILOT_USB_ROLE=host
# 판다(pandad)를 띄운다. 송신·활성 heartbeat는 매니저 기본값(EDGEPILOT_PANDA_TX=1,
# EDGEPILOT_PANDA_ENGAGED=1)을 따른다. 송신 없이 보려면 EDGEPILOT_PANDA_TX=0을 더한다.
Environment=EDGEPILOT_ENABLE_PANDA=1
ExecStart=/usr/local/bin/python3 @DEST@/manager.py
# SIGTERM은 매니저에만 보내고(자식을 순서대로 끈다), 남은 프로세스는 제한 시간 뒤 SIGKILL.
KillMode=mixed
TimeoutStopSec=10
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
